{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PrintBridge": {
    "PrinterNamePatterns": [ "*Zebra*", "*BSmart*", "*4BARCODE*" ],
    "Port": 9100,
    "ListenAddress": "0.0.0.0",
    "SendAck": true,
    "ResolveOnEveryPrint": false
  }
}