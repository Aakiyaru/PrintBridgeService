<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<appSettings>
		<!--
      EN: Comma-separated printer name masks. First match wins.
          Wildcards: * = any sequence, ? = any single char. Case-insensitive.
      RU: Маски имён принтеров через запятую. Побеждает первое совпадение.
          Wildcards: * = любая последовательность, ? = любой один символ.
          Регистр не важен.
    -->
		<add key="PrinterNamePatterns" value="*Zebra*,*BSmart*,*4BARCODE*" />

		<!--
      EN: Exact printer name. If set, masks are ignored.
      RU: Точное имя принтера. Если задано - маски игнорируются.
    -->
		<add key="PrinterName" value="" />

		<!--
      EN: TCP port to listen on for raw print jobs. 9100 is the standard RAW port.
      RU: TCP-порт для приёма raw-заданий. 9100 - стандартный RAW-порт.
    -->
		<add key="Port" value="9100" />

		<!--
      EN: Bind address. 0.0.0.0 = all interfaces, 127.0.0.1 = local only.
      RU: Адрес привязки. 0.0.0.0 = все интерфейсы, 127.0.0.1 = только локально.
    -->
		<add key="ListenAddress" value="0.0.0.0" />

		<!--
      EN: If true, send "OK\n" to the client after each successfully printed job.
      RU: Если true, отправлять "OK\n" клиенту после успешной печати.
    -->
		<add key="SendAck" value="true" />

		<!--
      EN: If true, re-resolve the printer by mask on every print (slower but always fresh).
          If false, resolve once and cache - re-resolve only on error 1801.
      RU: Если true, переискивать принтер по маске при каждой печати (медленнее, но актуально).
          Если false, найти один раз и кэшировать - переискивать только при ошибке 1801.
    -->
		<add key="ResolveOnEveryPrint" value="false" />

		<!--
      EN: Log file path. Relative paths are resolved against the exe folder.
      RU: Путь к лог-файлу. Относительные пути считаются от папки с exe.
    -->
		<add key="LogFile" value="ZplPrintBridge.log" />
	</appSettings>
</configuration>